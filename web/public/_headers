# Cloudflare static-asset response headers. Deep links (/vocab/set/…) are served by the SPA fallback
# set in wrangler.toml (not_found_handling = "single-page-application").

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Hashed bundles never change: cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always check for a new app shell, service worker and word list.
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/vocab.json
  Cache-Control: no-cache
